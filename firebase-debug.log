[debug] [2026-07-30T18:17:10.529Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/normatel-rh/rulesets {"name":"projects/normatel-rh/rulesets/8a311a71-963a-48d3-8c6b-f97513776891","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    function isStatusUsuarioValido(status) {\r\n      return status == 'pendente' || status == 'aprovado' || status == 'rejeitado';\r\n    }\r\n\r\n    function isRoleValido(role) {\r\n      return role == 'admin' || role == 'colaborador';\r\n    }\r\n\r\n    function isCadastroUsuarioValido() {\r\n      return request.resource.data.keys().hasAll(['email','nome','status','criado_em'])\r\n        && request.resource.data.email is string\r\n        && request.resource.data.nome is string\r\n        && request.resource.data.status is string\r\n        && request.resource.data.criado_em is string\r\n        && request.resource.data.email.size() > 3\r\n        && request.resource.data.email.size() <= 180\r\n        && request.resource.data.nome.size() > 0\r\n        && request.resource.data.nome.size() <= 180\r\n        && isStatusUsuarioValido(request.resource.data.status);\r\n    }\r\n\r\n    function isAtualizacaoModeracaoUsuarioValida() {\r\n      return request.resource.data.diff(resource.data).affectedKeys()\r\n               .hasOnly(['status', 'aprovado', 'atualizado_em', 'role'])\r\n        && request.resource.data.email == resource.data.email\r\n        && request.resource.data.nome == resource.data.nome\r\n        && request.resource.data.status is string\r\n        && isStatusUsuarioValido(request.resource.data.status)\r\n        && request.resource.data.aprovado is bool\r\n        && (\r\n          (request.resource.data.status == 'aprovado' && request.resource.data.aprovado == true) ||\r\n          (request.resource.data.status == 'rejeitado' && request.resource.data.aprovado == false) ||\r\n          (request.resource.data.status == 'pendente' && request.resource.data.aprovado == false)\r\n        )\r\n        && (\r\n          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||\r\n          isRoleValido(request.resource.data.role)\r\n        );\r\n    }\r\n\r\n    function isEnvioValido() {\r\n      let d = request.resource.data;\r\n      let isObito = d.tipo_atestado == 'Atestado de Óbito';\r\n      return d.keys().hasAll([\r\n          'nome','funcao','projeto','tipo_atestado',\r\n          'data_inicio','data_fim','arquivos','criado_em'\r\n        ])\r\n        && d.nome is string\r\n        && d.funcao is string\r\n        && d.projeto is string\r\n        && d.tipo_atestado is string\r\n        && d.data_inicio is string\r\n        && d.data_fim is string\r\n        && d.arquivos is list\r\n        && d.criado_em is string\r\n        && d.nome.size() > 0\r\n        && d.nome.size() <= 150\r\n        && d.funcao.size() > 0\r\n        && d.funcao.size() <= 120\r\n        && d.projeto.size() > 0\r\n        && d.projeto.size() <= 120\r\n        && d.tipo_atestado.size() > 0\r\n        && d.tipo_atestado.size() <= 80\r\n        && d.arquivos.size() >= 1\r\n        && d.arquivos.size() <= 10\r\n        && (\r\n          isObito\r\n            ? (!d.keys().hasAny(['dias'])\r\n               && d.grau_parentesco is string\r\n               && d.grau_parentesco.size() > 0\r\n               && d.grau_parentesco.size() <= 40)\r\n            : (d.dias is int && d.dias >= 1 && d.dias <= 365)\r\n        );\r\n    }\r\n\r\n    function isAtualizacaoAtendimentoEnvioValida() {\r\n      return request.resource.data.diff(resource.data).affectedKeys()\r\n               .hasOnly(['atendimento_status', 'atendimento_atualizado_em', 'historico'])\r\n        && request.resource.data.atendimento_status is string\r\n        && (request.resource.data.atendimento_status == 'feito'\r\n            || request.resource.data.atendimento_status == 'pendente')\r\n        && request.resource.data.atendimento_atualizado_em is string;\r\n    }\r\n\r\n    function isSoftDeleteEnvioValido() {\r\n      return request.resource.data.diff(resource.data).affectedKeys()\r\n               .hasOnly(['excluido', 'excluido_em', 'motivo_exclusao', 'excluido_por', 'historico'])\r\n        && request.resource.data.excluido == true\r\n        && request.resource.data.excluido_em is string\r\n        && request.resource.data.motivo_exclusao is string\r\n        && request.resource.data.motivo_exclusao.size() > 0\r\n        && request.resource.data.motivo_exclusao.size() <= 300;\r\n    }\r\n\r\n    function isRestauracaoEnvioValida() {\r\n      return request.resource.data.diff(resource.data).affectedKeys()\r\n               .hasOnly(['excluido', 'excluido_em', 'historico'])\r\n        && request.resource.data.excluido == false;\r\n    }\r\n\r\n    function isAtualizacaoCargoValida() {\r\n      return request.resource.data.diff(resource.data).affectedKeys()\r\n               .hasOnly(['role', 'atualizado_em'])\r\n        && request.resource.data.email == resource.data.email\r\n        && request.resource.data.nome == resource.data.nome\r\n        && isRoleValido(request.resource.data.role);\r\n    }\r\n\r\n    // Usuários RH:\r\n    // - Leitura pública: painel RH usa MSAL (não Firebase Auth), então request.auth é null\r\n    //   para admins — exigir auth bloquearia o painel inteiro.\r\n    // - Create: registro público com validação de campos obrigatórios\r\n    // - Update: moderação (status/aprovado/role) ou alteração de cargo isolada\r\n    // - Delete: bloqueado; feito apenas via Admin SDK\r\n    match /usuarios_rh/{userDoc} {\r\n      allow read: if true;\r\n      allow create: if isCadastroUsuarioValido();\r\n      allow update: if isAtualizacaoModeracaoUsuarioValida()\r\n                    || isAtualizacaoCargoValida();\r\n      allow delete: if false;\r\n    }\r\n\r\n    // Atestados enviados:\r\n    // - Leitura pública: painel RH usa MSAL (não Firebase Auth), request.auth é null\r\n    // - Create: formulário público com validação de campos obrigatórios\r\n    // - Update: somente campos permitidos (status, soft-delete, restauração)\r\n    //   sem exigência de Firebase Auth pelo mesmo motivo acima\r\n    // - Delete permanente: bloqueado; app usa apenas soft-delete (excluido: true)\r\n    match /envios_atestados/{envioDoc} {\r\n      allow read: if true;\r\n      allow create: if isEnvioValido();\r\n      allow update: if isAtualizacaoAtendimentoEnvioValida()\r\n                    || isSoftDeleteEnvioValido()\r\n                    || isRestauracaoEnvioValida();\r\n      allow delete: if false;\r\n    }\r\n\r\n    // Eventos de frontend: escrita pública com rate-limit na Cloud Function\r\n    // Leitura apenas autenticada\r\n    match /eventos_frontend/{eventoDoc} {\r\n      allow read: if request.auth != null;\r\n      allow create: if request.resource.data.keys().hasAll(['acao', 'criado_em'])\r\n                    && request.resource.data.acao is string\r\n                    && request.resource.data.acao.size() > 0\r\n                    && request.resource.data.acao.size() <= 80;\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // Projetos:\r\n    // - Leitura pública (colaboradores precisam ver sem Firebase Auth)\r\n    // - Create/Update: público com validação — RH autentica via MSAL, não Firebase Auth\r\n    // - Delete permanente: bloqueado; app usa soft-delete (excluido: true)\r\n    match /projetos/{projetoDoc} {\r\n      allow read: if true;\r\n      allow create: if request.resource.data.nome is string\r\n                    && request.resource.data.nome.size() > 0\r\n                    && request.resource.data.nome.size() <= 200;\r\n      allow update: if request.resource.data.nome is string\r\n                    && request.resource.data.nome.size() > 0\r\n                    && request.resource.data.nome.size() <= 200;\r\n      allow delete: if false;\r\n    }\r\n\r\n    // Logs de auditoria (quem marcou feito / quem excluiu):\r\n    // - Leitura pública (painel RH usa MSAL, sem Firebase Auth)\r\n    // - Create: escrita pública com validação mínima\r\n    // - Update/Delete: bloqueado; logs são imutáveis\r\n    match /logs_auditoria/{logDoc} {\r\n      allow read: if true;\r\n      allow create: if request.resource.data.keys().hasAll(['acao', 'criado_em'])\r\n                    && request.resource.data.acao is string\r\n                    && request.resource.data.acao.size() > 0\r\n                    && request.resource.data.acao.size() <= 80\r\n                    && request.resource.data.criado_em is string;\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // Confirmações do aviso obrigatório antes do envio de atestado:\r\n    // - Create público com validação; registro imutável (log)\r\n    // - Leitura apenas autenticada\r\n    match /confirmacoes_aviso/{confDoc} {\r\n      allow read: if request.auth != null;\r\n      allow create: if request.resource.data.keys().hasAll(['formulario', 'confirmado_em'])\r\n                    && request.resource.data.formulario is string\r\n                    && request.resource.data.formulario.size() > 0\r\n                    && request.resource.data.formulario.size() <= 80\r\n                    && request.resource.data.confirmado_em is string;\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // Todo o resto: somente usuário autenticado\r\n    match /{document=**} {\r\n      allow read, write: if request.auth != null;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-07-30T18:17:09.750623Z","metadata":{"services":["cloud.firestore"]}}
