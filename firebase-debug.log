[debug] [2026-07-30T17:02:20.454Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/normatel-rh/rulesets {"name":"projects/normatel-rh/rulesets/daf1e87a-67c1-4768-b224-5a18f12632bf","source":{"files":[{"content":"rules_version = '2';\r\nservice firebase.storage {\r\n  match /b/{bucket}/o {\r\n    // Envio de atestado (formulário público, funcionário sem login).\r\n    // O painel RH usa login Microsoft (MSAL), que NÃO cria sessão Firebase\r\n    // Auth, portanto request.auth é sempre null no client.\r\n    // - Escrita: pública, mas restrita a PDF e < 30MB.\r\n    // - Leitura via regra: BLOQUEADA (get/list negados). O acesso ao PDF\r\n    //   ocorre exclusivamente pela URL de download com token secreto\r\n    //   (alt=media&token=UUID), que NÃO é avaliada por estas regras.\r\n    //   Ninguém consegue listar nem baixar arquivos de outro envio sem o\r\n    //   token, que só é conhecido por quem enviou e pelo painel RH.\r\n    match /envios/{envioId}/{fileName} {\r\n      allow write: if request.resource.size < 30 * 1024 * 1024\r\n                   && request.resource.contentType == 'application/pdf';\r\n      allow read: if false;\r\n    }\r\n\r\n    // Caminho legado: escrita e leitura bloqueadas.\r\n    match /atestados/{allPaths=**} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    // Everything else: blocked\r\n    match /{allPaths=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\n","name":"storage.rules"}]},"createTime":"2026-07-30T17:02:19.678703Z","metadata":{"services":["firebase.storage"]}}
