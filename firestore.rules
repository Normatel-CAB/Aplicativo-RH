rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares
    function isStatusUsuarioValido(status) {
      return status == 'pendente' || status == 'aprovado' || status == 'rejeitado';
    }
    
    function isRoleValido(role) {
      return role == 'admin' || role == 'colaborador';
    }
    
    function isCadastroUsuarioValido() {
      return request.resource.data.keys().hasAll(['email','nome','status','criado_em'])
        && request.resource.data.email is string
        && request.resource.data.nome is string
        && request.resource.data.status is string
        && request.resource.data.criado_em is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 180
        && isStatusUsuarioValido(request.resource.data.status)
        && request.resource.data.status == 'pendente'
        && !request.resource.data.keys().hasAny(['aprovado']) || request.resource.data.aprovado == false
        && !request.resource.data.keys().hasAny(['role']);
    }
    
    function isAtualizacaoModeracaoUsuarioValida() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'aprovado', 'atualizado_em', 'role'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.nome == resource.data.nome
        && request.resource.data.status is string
        && isStatusUsuarioValido(request.resource.data.status)
        && request.resource.data.aprovado is bool
        && (
          (request.resource.data.status == 'aprovado' && request.resource.data.aprovado == true) ||
          (request.resource.data.status == 'rejeitado' && request.resource.data.aprovado == false) ||
          (request.resource.data.status == 'pendente' && request.resource.data.aprovado == false)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          isRoleValido(request.resource.data.role)
        );
    }
    
    function isEnvioValido() {
      let d = request.resource.data;
      let isObito = d.tipo_atestado == 'Atestado de Óbito';
      return d.keys().hasAll([
        'nome','funcao','projeto','tipo_atestado',
        'data_inicio','data_fim','arquivos','criado_em'
      ])
        && d.nome is string
        && d.funcao is string
        && d.projeto is string
        && d.tipo_atestado is string
        && d.data_inicio is string
        && d.data_fim is string
        && d.arquivos is list
        && d.criado_em is string
        && d.nome.size() > 0
        && d.nome.size() <= 150
        && d.funcao.size() > 0
        && d.funcao.size() <= 120
        && d.projeto.size() > 0
        && d.projeto.size() <= 120
        && d.tipo_atestado.size() > 0
        && d.tipo_atestado.size() <= 80
        && d.arquivos.size() >= 1
        && d.arquivos.size() <= 10
        && (
          isObito
            ? (!d.keys().hasAny(['dias'])
              && d.grau_parentesco is string
              && d.grau_parentesco.size() > 0
              && d.grau_parentesco.size() <= 40)
            : (d.dias is int && d.dias >= 1 && d.dias <= 365)
        );
    }
    
    function isAtualizacaoAtendimentoEnvioValida() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['atendimento_status', 'atendimento_atualizado_em', 'historico'])
        && request.resource.data.atendimento_status is string
        && (request.resource.data.atendimento_status == 'feito'
            || request.resource.data.atendimento_status == 'pendente')
        && request.resource.data.atendimento_atualizado_em is string;
    }
    
    function isSoftDeleteEnvioValido() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['excluido', 'excluido_em', 'motivo_exclusao', 'excluido_por', 'historico'])
        && request.resource.data.excluido == true
        && request.resource.data.excluido_em is string
        && request.resource.data.motivo_exclusao is string
        && request.resource.data.motivo_exclusao.size() > 0
        && request.resource.data.motivo_exclusao.size() <= 300;
    }
    
    function isRestauracaoEnvioValida() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['excluido', 'excluido_em', 'historico'])
        && request.resource.data.excluido == false;
    }
    
    function isAtualizacaoCargoValida() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['role', 'atualizado_em'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.nome == resource.data.nome
        && isRoleValido(request.resource.data.role);
    }
    
    // Usuários RH (contém PII: nome/email/cargo):
    // - Leitura: Permitida apenas para usuários autenticados com Firebase Auth
    // - Create: auto-cadastro público, mas sempre pendente e sem cargo
    //   (isCadastroUsuarioValido impede nascer admin/aprovado).
    // - Update/Delete: BLOQUEADOS. Aprovação, rejeição e mudança de cargo
    //   ocorrem exclusivamente via API admin (Admin SDK) — impede
    //   escalonamento de privilégio por escrita anônima.
    match /usuarios_rh/{userDoc} {
      // Permitir leitura apenas para usuários autenticados (Firebase Auth)
      allow read: if request.auth != null;
      allow create: if isCadastroUsuarioValido();
      allow update, delete: if false;
    }
    
    // Atestados enviados:
    // - Leitura: permitida para todos (painel RH usa MSAL, não Firebase Auth)
    // - Create: formulário público com validação de campos obrigatórios
    // - Update: somente campos permitidos (status, soft-delete, restauração)
    //   sem exigência de Firebase Auth pelo mesmo motivo acima
    // - Delete permanente: bloqueado; app usa apenas soft-delete (excluido: true)
    match /envios_atestados/{envioDoc} {
      allow read: if true;
      allow create: if isEnvioValido();
      allow update: if isAtualizacaoAtendimentoEnvioValida()
                  || isSoftDeleteEnvioValido()
                  || isRestauracaoEnvioValida();
      allow delete: if false;
    }
    
    // Eventos de frontend: escrita pública com rate-limit na Cloud Function
    // Leitura apenas autenticada
    match /eventos_frontend/{eventoDoc} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['acao', 'criado_em'])
                  && request.resource.data.acao is string
                  && request.resource.data.acao.size() > 0
                  && request.resource.data.acao.size() <= 80;
      allow update, delete: if false;
    }
    
    // Projetos:
    // - Leitura: permitida para todos (colaboradores precisam ver sem Firebase Auth)
    // - Create/Update: público com validação — RH autentica via MSAL, não Firebase Auth
    // - Delete permanente: bloqueado; app usa soft-delete (excluido: true)
    match /projetos/{projetoDoc} {
      allow read: if true;
      allow create: if request.resource.data.nome is string
                  && request.resource.data.nome.size() > 0
                  && request.resource.data.nome.size() <= 200;
      allow update: if request.resource.data.nome is string
                  && request.resource.data.nome.size() > 0
                  && request.resource.data.nome.size() <= 200;
      allow delete: if false;
    }
    
    // Logs de auditoria (quem marcou feito / quem excluiu):
    // - Leitura: permitida para todos (painel RH usa MSAL, sem Firebase Auth)
    // - Create: escrita pública com validação mínima
    // - Update/Delete: bloqueado; logs são imutáveis
    match /logs_auditoria/{logDoc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['acao', 'criado_em'])
                  && request.resource.data.acao is string
                  && request.resource.data.acao.size() > 0
                  && request.resource.data.acao.size() <= 80
                  && request.resource.data.criado_em is string;
      allow update, delete: if false;
    }
    
    // Confirmações do aviso obrigatório antes do envio de atestado:
    // - Leitura: permitida apenas para usuários autenticados
    // - Create: público com validação; registro imutável (log)
    match /confirmacoes_aviso/{confDoc} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['formulario', 'confirmado_em'])
                  && request.resource.data.formulario is string
                  && request.resource.data.formulario.size() > 0
                  && request.resource.data.formulario.size() <= 80
                  && request.resource.data.confirmado_em is string;
      allow update, delete: if false;
    }
    
    // Todo o resto: somente usuário autenticado
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}